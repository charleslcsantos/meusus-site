---
/**
 * Página 404 - Não encontrado
 */

import Layout from '@/layouts/Layout.astro';
import { SearchX, Home } from 'lucide-react';
---

<Layout 
  title="Página não encontrada - MeuSUS"
  description="A página que você procura não foi encontrada."
>
  <div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <SearchX size={40} className="text-gray-400" />
      </div>
      
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Página não encontrada
      </h1>
      
      <p class="text-gray-600 mb-8">
        A página que você está procurando não existe ou foi movida.
      </p>
      
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-teal-600 text-white 
               font-medium rounded-lg hover:bg-teal-700 transition-colors"
      >
        <Home size={18} />
        Voltar para página inicial
      </a>
    </div>
  </div>
</Layout>