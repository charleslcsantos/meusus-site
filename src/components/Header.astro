---
/**
 * Header do site com logo e navegação
 */
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 bg-teal-600 rounded-lg flex items-center justify-center
                    group-hover:bg-teal-700 transition-colors">
          <span class="text-white font-bold text-lg">SUS</span>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold text-gray-900 leading-tight">MeuSUS</span>
          <span class="text-xs text-gray-500 leading-tight">Salvador/BA</span>
        </div>
      </a>
      
      <!-- Navegação (se necessário no futuro) -->
      <nav class="hidden sm:flex items-center gap-4">
        <a 
          href="/" 
          class="text-sm text-gray-600 hover:text-teal-600 transition-colors"
        >
          Buscar
        </a>
        <!-- Links adicionais podem ser adicionados aqui -->
      </nav>
    </div>
  </div>
</header>